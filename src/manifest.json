{
  "manifest_version": 3,
  "name": "Dreaming Precise Time",
  "version": "1.0.0",
  "description": "Shows precise time (hours and minutes) on Dreaming French/Spanish progress pages",
  "host_permissions": [
    "https://app.dreaming.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.dreaming.com/french/progress",
        "https://app.dreaming.com/spanish/progress"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
